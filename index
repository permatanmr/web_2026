<title>Modul Praktikum JavaScript</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap">

<style>
  /* ============ TOKENS ============ */
  :root{
    --bg:#F5F6F8;
    --surface:#FFFFFF;
    --surface-2:#ECEEF2;
    --border:#DCE0E6;
    --text:#1A2029;
    --text-muted:#5B6472;
    --accent:#B45309;
    --accent-ink:#FFFFFF;
    --accent-soft:#FDECC8;
    --good:#0F7A5C;
    --good-soft:#DCFCE7;
    --bad:#C0281C;
    --bad-soft:#FEE2E2;
    --shadow: 0 1px 2px rgba(20,23,28,0.04), 0 4px 16px rgba(20,23,28,0.06);
    --radius: 12px;
    --editor-bg:#1B212C;
    --editor-bg-2:#141922;
    --editor-text:#E7E9EE;
    --editor-muted:#8890A0;
    --editor-border:#2C3341;
    --header-h: 128px;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#14171C;
      --surface:#1B1F27;
      --surface-2:#232833;
      --border:#2E3440;
      --text:#E7E9EE;
      --text-muted:#9AA3B2;
      --accent:#F0A93A;
      --accent-ink:#1A1200;
      --accent-soft:rgba(240,169,58,0.16);
      --good:#4ADE94;
      --good-soft:rgba(74,222,148,0.14);
      --bad:#FB7267;
      --bad-soft:rgba(251,114,103,0.14);
      --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px rgba(0,0,0,0.35);
    }
  }
  :root[data-theme="dark"]{
    --bg:#14171C;
    --surface:#1B1F27;
    --surface-2:#232833;
    --border:#2E3440;
    --text:#E7E9EE;
    --text-muted:#9AA3B2;
    --accent:#F0A93A;
    --accent-ink:#1A1200;
    --accent-soft:rgba(240,169,58,0.16);
    --good:#4ADE94;
    --good-soft:rgba(74,222,148,0.14);
    --bad:#FB7267;
    --bad-soft:rgba(251,114,103,0.14);
    --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px rgba(0,0,0,0.35);
  }

  /* ============ BASE ============ */
  *,*::before,*::after{ box-sizing:border-box; }
  html{ scroll-behavior:smooth; }
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:"IBM Plex Sans", system-ui, -apple-system, sans-serif;
    font-size:16px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,h4{ font-family:"IBM Plex Sans", system-ui, sans-serif; text-wrap:balance; margin:0; }
  p{ margin:0 0 14px; color:var(--text); }
  a{ color:var(--accent); }
  ::selection{ background:var(--accent-soft); }
  .mono{ font-family:"JetBrains Mono", ui-monospace, monospace; }

  /* ============ HEADER ============ */
  header.top{
    position:sticky; top:0; z-index:50;
    background:var(--surface);
    border-bottom:1px solid var(--border);
  }
  .top-inner{
    max-width:1120px; margin:0 auto; padding:18px 24px 14px;
  }
  .eyebrow{
    display:inline-flex; align-items:center; gap:6px;
    font-size:11.5px; font-weight:600; letter-spacing:.08em; text-transform:uppercase;
    color:var(--accent); margin-bottom:8px;
  }
  .eyebrow .dot{ width:6px; height:6px; border-radius:50%; background:var(--accent); display:inline-block; }
  header.top h1{ font-size:clamp(22px,3vw,30px); font-weight:700; letter-spacing:-0.01em; }
  header.top .subtitle{ color:var(--text-muted); font-size:14.5px; margin-top:4px; max-width:640px; }

  nav.chips{
    display:flex; gap:8px; overflow-x:auto; padding:12px 24px 14px;
    max-width:1120px; margin:0 auto; scrollbar-width:thin;
  }
  nav.chips::-webkit-scrollbar{ height:6px; }
  nav.chips::-webkit-scrollbar-thumb{ background:var(--border); border-radius:99px; }
  nav.chips a{
    flex:0 0 auto;
    text-decoration:none;
    font-size:13px; font-weight:500;
    color:var(--text-muted);
    background:var(--surface-2);
    border:1px solid transparent;
    padding:6px 12px;
    border-radius:99px;
    white-space:nowrap;
    transition:background .15s, color .15s, border-color .15s;
  }
  nav.chips a:hover{ color:var(--text); }
  nav.chips a.active{
    background:var(--accent-soft); color:var(--accent); border-color:var(--accent);
    font-weight:600;
  }

  /* ============ LAYOUT ============ */
  main{ max-width:760px; margin:0 auto; padding:40px 24px 100px; }

  .intro-card{
    background:var(--surface); border:1px solid var(--border); border-radius:var(--radius);
    padding:22px 24px; margin-bottom:48px; box-shadow:var(--shadow);
  }
  .intro-card h2{ font-size:15px; text-transform:uppercase; letter-spacing:.06em; color:var(--accent); margin-bottom:12px; font-weight:700; }
  .legend{ display:flex; flex-wrap:wrap; gap:10px 18px; margin-top:14px; font-size:13px; color:var(--text-muted); }
  .legend span{ display:inline-flex; align-items:center; gap:6px; }
  .swatch{ width:12px; height:12px; border-radius:4px; display:inline-block; }

  section.chapter{ margin-bottom:64px; scroll-margin-top: 150px; }
  .chapter-kicker{
    font-family:"JetBrains Mono", monospace; font-size:13px; color:var(--text-muted);
    margin-bottom:6px; letter-spacing:.02em;
  }
  .chapter h2.title{ font-size:clamp(22px,2.6vw,28px); font-weight:700; letter-spacing:-0.01em; margin-bottom:16px; }
  .chapter .intro p{ color:var(--text-muted); font-size:15.5px; }

  h3.sec-heading{
    font-size:18px; font-weight:700; margin:32px 0 10px; color:var(--text);
    scroll-margin-top:150px;
  }
  h4.code-heading{
    font-size:14.5px; font-weight:600; margin:22px 0 4px; color:var(--text);
  }
  .code-note{ font-size:13px; color:var(--text-muted); font-style:italic; margin:0 0 10px; }

  /* ============ PLAYGROUND ============ */
  .pg{
    background:var(--editor-bg);
    border:1px solid var(--editor-border);
    border-radius:10px;
    overflow:hidden;
    margin:10px 0 22px;
    box-shadow:var(--shadow);
  }
  .pg-tabs, .pg-head{
    display:flex; align-items:center; gap:2px;
    background:var(--editor-bg-2);
    border-bottom:1px solid var(--editor-border);
    padding:0 8px;
  }
  .pg-tabs button.tab{
    font-family:"JetBrains Mono", monospace; font-size:11.5px; font-weight:600; letter-spacing:.04em;
    color:var(--editor-muted); background:transparent; border:none; cursor:pointer;
    padding:10px 12px; border-bottom:2px solid transparent;
  }
  .pg-tabs button.tab.active{ color:var(--editor-text); border-bottom-color:var(--accent); }
  .pg-label{
    font-family:"JetBrains Mono", monospace; font-size:11.5px; font-weight:600; letter-spacing:.06em;
    color:var(--editor-muted); padding:10px 4px;
  }
  .pg-actions{ margin-left:auto; display:flex; gap:6px; padding:6px; }
  .pg button.act{
    font-family:"IBM Plex Sans", sans-serif; font-size:12.5px; font-weight:600;
    border:1px solid var(--editor-border); background:#242B38; color:var(--editor-text);
    padding:6px 11px; border-radius:6px; cursor:pointer; display:inline-flex; align-items:center; gap:5px;
    transition:background .15s, border-color .15s;
  }
  .pg button.act:hover{ background:#2C3444; }
  .pg button.act.run{ background:var(--accent); border-color:var(--accent); color:var(--accent-ink); }
  .pg button.act.run:hover{ filter:brightness(1.08); }

  .pg-editor{
    display:block; width:100%; min-height:64px;
    background:var(--editor-bg); color:var(--editor-text);
    font-family:"JetBrains Mono", ui-monospace, monospace; font-size:13px; line-height:1.55;
    border:none; outline:none; resize:vertical;
    padding:14px 16px; tab-size:2;
    field-sizing: content;
  }
  .pg-editor::placeholder{ color:var(--editor-muted); }

  .pg-console, .pg-preview-wrap{ border-top:1px solid var(--editor-border); background:#12161D; }
  .pg-console-label, .pg-preview-label{
    font-family:"JetBrains Mono", monospace; font-size:10.5px; font-weight:700; letter-spacing:.08em;
    color:var(--editor-muted); padding:8px 16px 0;
  }
  .pg-console-output{
    margin:0; padding:8px 16px 14px; min-height:20px; max-height:260px; overflow:auto;
    font-family:"JetBrains Mono", ui-monospace, monospace; font-size:12.5px; line-height:1.6;
    color:#B7F5C9; white-space:pre-wrap; word-break:break-word;
  }
  .pg-console-output .err{ color:#FF9C93; }
  .pg-console-output .empty{ color:var(--editor-muted); font-style:italic; }
  .pg-preview{
    display:block; width:100%; height:220px; border:none; background:#fff;
  }

  /* ============ EXERCISES ============ */
  .exercises-title{ font-size:15px; text-transform:uppercase; letter-spacing:.06em; color:var(--text-muted); font-weight:700; margin:40px 0 14px; }
  .exercise{
    background:var(--surface); border:1px solid var(--border); border-radius:var(--radius);
    margin-bottom:16px; overflow:hidden; box-shadow:var(--shadow);
  }
  .exercise-soal{ padding:16px 20px; }
  .exercise-soal .tag{
    display:inline-block; font-family:"JetBrains Mono",monospace; font-size:11px; font-weight:700;
    color:var(--accent); background:var(--accent-soft); padding:2px 8px; border-radius:5px; margin-bottom:8px;
  }
  .exercise-soal p{ margin:0; font-size:15px; }
  .kunci-toggle{
    width:100%; text-align:left; border:none; border-top:1px solid var(--border);
    background:var(--surface-2); color:var(--text-muted); font-family:"IBM Plex Sans",sans-serif;
    font-size:13px; font-weight:600; padding:10px 20px; cursor:pointer;
    display:flex; align-items:center; gap:8px;
  }
  .kunci-toggle:hover{ color:var(--text); }
  .kunci-toggle .chev{ transition:transform .15s; }
  .kunci-toggle.open .chev{ transform:rotate(90deg); }
  .kunci-body{ padding:4px 20px 18px; }
  .kunci-body[hidden]{ display:none; }
  .kunci-body .pg{ margin-top:12px; margin-bottom:6px; }
  .kunci-text{
    font-size:14.5px; color:var(--text); background:var(--good-soft); border:1px solid var(--good);
    border-radius:8px; padding:12px 14px; margin-top:12px;
  }

  /* ============ CHALLENGE LIST ============ */
  .challenge-list{
    background:var(--surface); border:1px solid var(--border); border-radius:var(--radius);
    padding:18px 22px; box-shadow:var(--shadow); margin-top:18px;
  }
  .challenge-list p{ font-size:14.5px; }
  .challenge-list p:last-child{ margin-bottom:0; }

  /* ============ CHEATSHEET ============ */
  .cheat-grid{
    display:grid; grid-template-columns:1fr 1fr; gap:1px;
    background:var(--border); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden;
  }
  .cheat-row{ display:contents; }
  .cheat-cat, .cheat-val{ background:var(--surface); padding:11px 16px; font-size:13.5px; }
  .cheat-cat{ font-weight:600; color:var(--text-muted); }
  .cheat-val{ font-family:"JetBrains Mono",monospace; font-size:12.5px; color:var(--text); }
  @media (max-width:600px){
    .cheat-grid{ grid-template-columns:1fr; }
    .cheat-row{ display:block; border-bottom:1px solid var(--border); }
  }

  footer.site{
    max-width:760px; margin:0 auto; padding:20px 24px 60px; color:var(--text-muted); font-size:13px;
  }
  footer.site a{ color:var(--text-muted); text-decoration:underline; }

  .refs li{ margin-bottom:8px; font-size:14.5px; }
  .refs{ padding-left:20px; margin:0; }

  @media (prefers-reduced-motion: reduce){
    html{ scroll-behavior:auto; }
    *{ transition:none !important; }
  }
</style>

